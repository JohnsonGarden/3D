{
  "name": "lego-world-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Child-first browser LEGO car playground, with SDD/TDD harness",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test src/sim/*.test.ts src/garage/*.test.ts src/controls/*.test.ts src/game/*.test.ts",
    "check:spec": "node scripts/check-spec.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "ci": "npm run check:spec && npm test && npm run build && npm run test:deploy",
    "test:deploy": "node --test tests/deploy/*.test.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "start:local": "bash scripts/start-local.sh"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
